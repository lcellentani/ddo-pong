{
  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--header-insertion=iwyu",
          "--completion-style=detailed",
          "--compile-commands-dir=build/debug"
        ]
      }
    }
  },
  "languages": {
    "C++": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": "language_server"
    }
  }
}
